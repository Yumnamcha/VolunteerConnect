DATABASE_URL=postgresql+psycopg2://volunteer:volunteer123@localhost:5432/volunteerconnect
JWT_SECRET=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Used to build the password reset link that gets emailed to users.
FRONTEND_URL=http://localhost:5173

# Optional: without these, "forgot password" still works locally - the reset
# link is returned directly in the API response instead of being emailed.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=a 16-character Gmail "App Password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
